---
import Base from '../../layouts/Base.astro';
import Hero from '../sections/Hero.astro';
import Context from '../sections/Context.astro';
import Statement from '../sections/Statement.astro';
import ServicesGrid from '../sections/ServicesGrid.astro';
import Why from '../sections/Why.astro';
import CtaBand from '../sections/CtaBand.astro';
import { t } from '../../i18n/dict.js';

const { lang } = Astro.props;
---

<Base
  lang={lang}
  page="home"
  title={t.home.metaTitle[lang]}
  description={t.home.metaDesc[lang]}
>
  <Hero lang={lang} />
  <Context lang={lang} />
  <Statement lang={lang} />
  <ServicesGrid lang={lang} />
  <Why lang={lang} />
  <CtaBand lang={lang} />
</Base>
