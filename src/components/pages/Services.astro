---
import Base from '../../layouts/Base.astro';
import PageHero from '../sections/PageHero.astro';
import CtaBand from '../sections/CtaBand.astro';
import ServicesGrid from '../sections/ServicesGrid.astro';
import Why from '../sections/Why.astro';
import { t } from '../../i18n/dict.js';

const { lang } = Astro.props;
---

<Base
  lang={lang}
  page="servicos"
  title={t.services.metaTitle[lang]}
  description={t.services.metaDesc[lang]}
>
  <PageHero
    eyebrow={t.services.eyebrow[lang]}
    title={t.services.title[lang]}
    lead={t.services.lead[lang]}
  />
  <ServicesGrid lang={lang} showHead={false} />
  <Why lang={lang} />
  <CtaBand lang={lang} />
</Base>
