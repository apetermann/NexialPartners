---
import Base from '../../layouts/Base.astro';
import PageHero from '../sections/PageHero.astro';
import Solutions from '../sections/Solutions.astro';
import Clients from '../sections/Clients.astro';
import CtaBand from '../sections/CtaBand.astro';
import { t } from '../../i18n/dict.js';

const { lang } = Astro.props;
---

<Base
  lang={lang}
  page="solucoes"
  title={t.solutions.metaTitle[lang]}
  description={t.solutions.metaDesc[lang]}
>
  <PageHero
    eyebrow={t.solutions.eyebrow[lang]}
    title={t.solutions.title[lang]}
    lead={t.solutions.lead[lang]}
  />
  <Solutions lang={lang} semCabecalho={true} />
  <Clients lang={lang} />
  <CtaBand lang={lang} />
</Base>
