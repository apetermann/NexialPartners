---
import Base from '../../layouts/Base.astro';
import PageHero from '../sections/PageHero.astro';
import ContactForm from '../ContactForm.astro';
import { t, CONTACT } from '../../i18n/dict.js';

const { lang } = Astro.props;
const temFormulario = Boolean(CONTACT.formEndpoint);
---

<Base
  lang={lang}
  page="contato"
  title={t.contact.metaTitle[lang]}
  description={t.contact.metaDesc[lang]}
>
  <PageHero
    eyebrow={t.contact.eyebrow[lang]}
    title={t.contact.title[lang]}
    lead={t.contact.lead[lang]}
  />

  <section class="section">
    <div class="wrap contato-grid">
      <div class="coluna-form" data-reveal>
        {temFormulario && <h2 class="rotulo">{t.form.eyebrow[lang]}</h2>}
        <ContactForm lang={lang} />
      </div>

      <aside class="coluna-lado" data-reveal style="--reveal-delay:90ms">
        <div class="bloco">
          <h2 class="rotulo">{t.contact.linkedinLabel[lang]}</h2>
          <a class="destaque" href={CONTACT.linkedin} target="_blank" rel="noopener">
            Nexial Partners<span class="arrow" aria-hidden="true">&nearr;</span>
          </a>
        </div>

        <div class="bloco">
          <h2 class="rotulo">{t.contact.addressLabel[lang]}</h2>
          <address>
            {t.footer.addressL1[lang]}<br />
            {t.footer.addressL2[lang]}
          </address>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contato-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .coluna-lado { display: flex; flex-direction: column; gap: 2.5rem; }

  .bloco { padding-top: 1.5rem; border-top: 2px solid var(--line); }

  .rotulo {
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .destaque {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 300;
    letter-spacing: -0.015em;
    color: var(--white);
  }
  .destaque .arrow { color: var(--accent); transition: transform 0.25s var(--ease); }
  .destaque:hover .arrow { transform: translate(3px, -3px); }

  address {
    font-style: normal;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--mist);
  }

  @media (max-width: 860px) {
    .contato-grid { grid-template-columns: 1fr; }
  }
</style>
