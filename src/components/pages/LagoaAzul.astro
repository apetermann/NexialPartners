---
import Base from '../../layouts/Base.astro';
import PageHero from '../sections/PageHero.astro';
import Clients from '../sections/Clients.astro';
import CtaBand from '../sections/CtaBand.astro';
import { t } from '../../i18n/dict.js';
import { url } from '../../i18n/utils.js';

const { lang } = Astro.props;
const p = t.projects.lagoaAzul;

const fotos = import.meta.glob('../../assets/projetos/*.jpg', { eager: true });
const img = (nome, w) => fotos[`../../assets/projetos/${nome}-${w}.jpg`].default.src;
---

<Base
  lang={lang}
  page="lagoaAzul"
  title={p.metaTitle[lang]}
  description={p.metaDesc[lang]}
>
  <PageHero
    eyebrow={`${t.projects.clientLabel[lang]} · ${p.client}`}
    title={p.name[lang]}
    lead={p.resumo[lang]}
  />

  <section class="section">
    <div class="wrap">
      <p class="voltar" data-reveal>
        <a class="link-line" href={url('projetos', lang)}>
          <span class="arrow" aria-hidden="true">&larr;</span>{t.projects.eyebrow[lang]}
        </a>
      </p>

      <div class="corpo">
        {p.descricao && (
          <div class="texto" data-reveal>
            <p>{p.descricao[lang]}</p>
          </div>
        )}

        {/* A ficha só mostra as linhas que têm conteúdo. */}
        {p.ficha.length > 0 && (
          <dl class="ficha" data-reveal style="--reveal-delay:90ms">
            {p.ficha.map((linha) => (
              <div class="linha">
                <dt>{linha.rotulo[lang]}</dt>
                <dd>{linha.valor[lang]}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>

      <figure class="galeria" data-reveal style="--reveal-delay:90ms">
        <div class="fotos">
          {p.fotos.map((nome) => (
            <img
              src={img(nome, 1000)}
              srcset={`${img(nome, 600)} 600w, ${img(nome, 1000)} 1000w`}
              sizes="(max-width: 760px) 92vw, 44vw"
              alt={p.galeriaLegenda[lang]}
              width="1000" height="1333" loading="lazy" decoding="async"
            />
          ))}
        </div>
        <figcaption>{p.galeriaLegenda[lang]}</figcaption>
      </figure>
    </div>
  </section>

  <Clients lang={lang} />
  <CtaBand lang={lang} />
</Base>

<style>
  .voltar { margin-bottom: 2.5rem; }
  .voltar a { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--mist); }
  .voltar .arrow { color: var(--accent); transition: transform 0.25s var(--ease); }
  .voltar a:hover .arrow { transform: translateX(-4px); }

  /* Texto e ficha lado a lado: a ficha e consulta, o texto e leitura. */
  .corpo {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .texto p {
    margin: 0;
    font-size: var(--fs-md);
    font-weight: 300;
    line-height: 1.68;
    color: var(--mist);
    text-wrap: pretty;
  }

  .ficha {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .linha {
    display: grid;
    grid-template-columns: minmax(6.5rem, 0.32fr) 1fr;
    gap: 1.25rem;
    padding: 0.9375rem 0;
    border-bottom: 1px solid var(--line-soft);
  }
  dt {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  dd { margin: 0; color: var(--mist); }

  .galeria { margin: 0; }
  /* Duas colunas fixas e largura maxima: com auto-fit as duas fotos em
     retrato esticavam em telas largas e dominavam a pagina. */
  .fotos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    max-width: 54rem;
  }
  .fotos img {
    width: 100%; height: auto;
    border-radius: 6px;
    border: 1px solid var(--line-soft);
  }
  figcaption {
    margin-top: 1.25rem;
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  @media (max-width: 880px) {
    .corpo { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .linha { grid-template-columns: 1fr; gap: 0.375rem; }
    .fotos { grid-template-columns: 1fr; }
  }
</style>
