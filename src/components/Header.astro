---
import { t, ROUTES } from '../i18n/dict.js';
import { url, asset, otherLang } from '../i18n/utils.js';

const { lang = 'pt', page = 'home' } = Astro.props;
const outra = otherLang(lang);

const links = ['modelo', 'servicos', 'mineracao', 'partners'];
---

<a class="skip-link" href="#conteudo">{t.a11y.skip[lang]}</a>

<header class="site-header" data-header>
  <div class="wrap header-inner">
    <a class="brand" href={url('home', lang)} aria-label={t.brand[lang]}>
      <img
        src={asset('assets/img/logo-nexial-white.png')}
        alt={t.brand[lang]}
        width="1100" height="308"
        transition:name="brand"
      />
    </a>

    <nav class="nav" id="nav" aria-label={t.a11y.nav[lang]}>
      {links.map((k) => (
        <a
          href={url(k, lang)}
          class:list={['nav-link', { 'is-current': page === k }]}
          aria-current={page === k ? 'page' : undefined}
        >
          {t.nav[k][lang]}
        </a>
      ))}
      <a href={url('contato', lang)} class="nav-cta">{t.nav.cta[lang]}</a>
    </nav>

    <div class="tools">
      <a
        class="lang-switch"
        href={url(page, outra)}
        hreflang={outra}
        aria-label={`${t.a11y.lang[lang]}: ${outra.toUpperCase()}`}
      >
        <span class="is-on">{lang.toUpperCase()}</span>
        <span aria-hidden="true">/</span>
        <span>{outra.toUpperCase()}</span>
      </a>

      <button type="button" class="menu-toggle" id="menu-toggle"
              aria-expanded="false" aria-controls="nav" aria-label={t.a11y.menu[lang]}>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .skip-link {
    position: absolute; top: -100px; left: 1rem; z-index: 300;
    background: var(--accent); color: var(--ink-deep);
    padding: 0.75rem 1.25rem; font-weight: 600; border-radius: var(--radius);
  }
  .skip-link:focus { top: 1rem; }

  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 200;
    border-bottom: 1px solid transparent;
    transition: background 0.4s var(--ease), border-color 0.4s var(--ease),
                backdrop-filter 0.4s var(--ease);
  }
  /* Fundo só aparece depois de sair do topo — no herói o cabeçalho flutua. */
  .site-header.is-stuck {
    background: rgba(8, 11, 22, 0.82);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-bottom-color: var(--line-soft);
  }

  .header-inner {
    display: flex; align-items: center; gap: 2rem;
    min-height: 6.5rem;
  }

  .brand { margin-right: auto; }
  .brand img {
    /* Proporcao do teaser: o logo ocupa 6,7% da altura do slide,
       o que em 1440px de viewport equivale a ~54px. */
    width: auto; height: clamp(2.5rem, 2rem + 1.4vw, 3.5rem);
    transition: opacity 0.25s var(--ease);
  }
  .brand:hover img { opacity: 0.8; }

  .nav { display: flex; align-items: center; gap: clamp(1.25rem, 2.4vw, 2.5rem); }

  .nav-link {
    position: relative;
    font-size: 0.9375rem;
    font-weight: 350;
    color: var(--mist);
    white-space: nowrap;
    padding-block: 0.25rem;
    transition: color 0.25s var(--ease);
  }
  .nav-link::after {
    content: ""; position: absolute; left: 0; bottom: 0;
    width: 100%; height: 1px; background: var(--accent);
    transform: scaleX(0); transform-origin: right;
    transition: transform 0.45s var(--ease-out);
  }
  .nav-link:hover { color: var(--white); }
  .nav-link:hover::after,
  .nav-link.is-current::after { transform: scaleX(1); transform-origin: left; }
  .nav-link.is-current { color: var(--white); }

  .nav-cta {
    padding: 0.5625rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 0.9375rem;
    color: var(--white);
    white-space: nowrap;
    transition: border-color 0.25s var(--ease), background 0.25s var(--ease);
  }
  .nav-cta:hover { border-color: var(--accent); background: var(--accent-dim); }

  .tools { display: flex; align-items: center; gap: 1.25rem; }

  .lang-switch {
    display: flex; gap: 0.3125rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    color: var(--muted);
    transition: color 0.25s var(--ease);
  }
  .lang-switch:hover { color: var(--mist); }
  .lang-switch .is-on { color: var(--accent-bright); }

  .menu-toggle {
    display: none;
    width: 2.5rem; height: 2.5rem;
    flex-direction: column; justify-content: center; align-items: flex-end; gap: 6px;
  }
  .menu-toggle span {
    display: block; height: 1px; background: var(--mist);
    transition: transform 0.4s var(--ease), width 0.4s var(--ease), opacity 0.3s;
  }
  .menu-toggle span:nth-child(1) { width: 22px; }
  .menu-toggle span:nth-child(2) { width: 14px; }
  .menu-toggle[aria-expanded='true'] span:nth-child(1) { width: 22px; transform: translateY(3.5px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] span:nth-child(2) { width: 22px; transform: translateY(-3.5px) rotate(-45deg); }

  @media (max-width: 940px) {
    .menu-toggle { display: flex; }

    .nav {
      position: fixed; inset: 5.25rem 0 auto;
      flex-direction: column; align-items: stretch; gap: 0;
      padding: 0.5rem var(--gutter) 2rem;
      background: rgba(8, 11, 22, 0.97);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--line-soft);
      clip-path: inset(0 0 100% 0);
      opacity: 0;
      transition: clip-path 0.5s var(--ease-out), opacity 0.3s var(--ease);
      pointer-events: none;
    }
    .nav.is-open { clip-path: inset(0 0 0 0); opacity: 1; pointer-events: auto; }

    .nav-link {
      padding-block: 1.125rem;
      font-size: 1.125rem;
      border-bottom: 1px solid var(--line-soft);
    }
    .nav-link::after { display: none; }
    .nav-cta { margin-top: 1.5rem; text-align: center; padding-block: 0.9375rem; }
  }
</style>

<script>
  function armarHeader() {
    const header = document.querySelector('[data-header]');
    const nav = document.getElementById('nav');
    const toggle = document.getElementById('menu-toggle');
    if (!header || !nav || !toggle) return;

    const aoRolar = () => header.classList.toggle('is-stuck', scrollY > 24);
    addEventListener('scroll', aoRolar, { passive: true });
    aoRolar();

    const fechar = () => {
      nav.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      const aberto = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', aberto ? 'true' : 'false');
    });
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', fechar));
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) { fechar(); toggle.focus(); }
    });
    addEventListener('resize', () => { if (innerWidth > 940) fechar(); });
  }

  armarHeader();
  document.addEventListener('astro:page-load', armarHeader);
</script>
