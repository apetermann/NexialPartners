---
import { t } from '../../i18n/dict.js';
import { asset } from '../../i18n/utils.js';
const { lang = 'pt' } = Astro.props;
---

<section class="section">
  <div class="wrap">
    <div class="people">
      {t.partners.people.map((p, i) => (
        <article class="person" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <div class="retrato">
            {/* alt vazio: o nome vem no <h3> logo abaixo */}
            <img
              src={asset(`assets/img/partners/${p.photo}.jpg`)}
              alt="" width="320" height="320" loading="lazy" decoding="async"
            />
          </div>
          <h3>{p.name}</h3>
          <p class="papel">{p.role[lang]}</p>
          <p class="bio">{p.bio[lang]}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .people {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13.5rem, 1fr));
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  .person { display: flex; flex-direction: column; }

  /* Moldura quadrada com a foto circular dentro: o hover expande o anel. */
  .retrato {
    position: relative;
    width: 8.5rem; height: 8.5rem;
    margin-bottom: 1.5rem;
  }
  .retrato::after {
    content: ""; position: absolute; inset: -6px;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition: inset 0.45s var(--ease-out), border-color 0.45s var(--ease);
  }
  .person:hover .retrato::after { inset: -11px; border-color: var(--accent); }

  .retrato img {
    width: 100%; height: 100%;
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.5s var(--ease);
  }

  .person h3 {
    margin-bottom: 0.25rem;
    font-size: 1.1875rem;
    letter-spacing: -0.012em;
  }
  .papel {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .bio { margin: 0; font-size: 0.9375rem; line-height: 1.62; color: var(--slate); }

  @media (max-width: 520px) {
    .retrato { width: 7rem; height: 7rem; }
  }
</style>
