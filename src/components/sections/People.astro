---
import { t } from '../../i18n/dict.js';
import { asset } from '../../i18n/utils.js';
const { lang = 'pt' } = Astro.props;
---

<section class="section">
  <div class="wrap">
    <div class="people">
      {t.partners.people.map((p, i) => (
        <article class="person" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          <div class="retrato">
            {/* alt vazio: o nome vem no <h3> logo abaixo */}
            <img
              src={asset(`assets/img/partners/${p.photo}.jpg`)}
              alt="" width="320" height="320" loading="lazy" decoding="async"
            />
          </div>
          <h3>{p.name}</h3>
          <p class="papel">{p.role[lang]}</p>
          <span class="divisa" aria-hidden="true"></span>
          <p class="bio">{p.bio[lang]}</p>
        </article>
      ))}
    </div>

    <aside class="complemento" data-reveal>
      <h2 class="rotulo">{t.partners.complementLabel[lang]}</h2>
      <p>{t.partners.complementText[lang]}</p>
    </aside>
  </div>
</section>

<style>
  .people {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: clamp(1rem, 1.6vw, 1.5rem);
    align-items: stretch;
  }

  .person {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(1.75rem, 2.4vw, 2.25rem) clamp(1rem, 1.6vw, 1.5rem);
    border: 1px solid var(--line-soft);
    border-radius: 6px;
    background: linear-gradient(170deg, var(--surface) 0%, var(--ink-soft) 100%);
    transition: border-color 0.45s var(--ease), transform 0.45s var(--ease);
  }
  .person:hover { border-color: var(--accent); transform: translateY(-4px); }

  /* Moldura circular com anel que se abre no hover. */
  .retrato {
    position: relative;
    width: 7.5rem; height: 7.5rem;
    margin-bottom: 1.5rem;
  }
  .retrato::after {
    content: ""; position: absolute; inset: -7px;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition: inset 0.45s var(--ease-out), border-color 0.45s var(--ease);
  }
  .person:hover .retrato::after { inset: -12px; border-color: var(--accent); }

  .retrato img {
    width: 100%; height: 100%;
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  .person h3 {
    margin-bottom: 0.375rem;
    font-size: 1.125rem;
    font-weight: 400;
    letter-spacing: -0.012em;
  }

  .papel {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.4;
    color: var(--accent-bright);
  }

  /* Divisória curta entre o cargo e a biografia, como no teaser. */
  .divisa {
    display: block;
    width: 2.25rem; height: 1px;
    margin: 1.25rem 0;
    background: var(--accent);
    opacity: 0.7;
  }

  .bio {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.62;
    color: var(--slate);
    text-wrap: pretty;
  }

  /* ── faixa "como se complementam" ─────────────────────────────────── */

  .complemento {
    display: grid;
    grid-template-columns: minmax(0, 0.28fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
    margin-top: clamp(1rem, 1.6vw, 1.5rem);
    padding: clamp(1.75rem, 2.8vw, 2.5rem);
    border: 1px solid var(--line-soft);
    border-radius: 6px;
    background: linear-gradient(170deg, var(--surface) 0%, var(--ink-soft) 100%);
  }

  .rotulo {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .complemento p {
    margin: 0;
    padding-left: clamp(1.25rem, 2.4vw, 2rem);
    border-left: 1px solid var(--line);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--mist);
    text-wrap: pretty;
  }

  @media (max-width: 700px) {
    .complemento { grid-template-columns: 1fr; }
    .complemento p { padding-left: 0; border-left: 0; }
    .rotulo { letter-spacing: 0.16em; }
  }
</style>
